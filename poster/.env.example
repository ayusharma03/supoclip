# Copy to .env (chmod 600). Never commit .env.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
INSTAGRAM_SYSTEM_USER_TOKEN=
INSTAGRAM_ACCOUNT_ID=
# Optional
YOUTUBE_DAILY_UPLOADS=5
YOUTUBE_LEAD_HOURS=720
INSTAGRAM_MIN_GAP_MINUTES=20
# Where the queue and clips live on the host (homelab: the HDD)
POSTER_DATA_DIR=/mnt/data/supoclip-poster
